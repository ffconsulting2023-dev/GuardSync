# ローカル開発用の環境変数テンプレート（scripts/setup-local.sh が .env にコピーし、秘密値を自動生成する）
# 本番・ステージングのDBやキーは絶対に書かないこと

# docker-compose.dev.yml の PostgreSQL（自前の PostgreSQL を使う場合は書き換える）
DATABASE_URL=postgresql://guardsync:guardsync@localhost:5432/guardsync_dev

# サーバー（vite.config.ts の /api プロキシが 3001 を向いているため 3001 固定）
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
# 空にすると画面は同じオリジンの /api を使い、Vite のプロキシ経由でサーバーへ届く
VITE_API_URL=

# setup-local.sh が自動生成する
JWT_SECRET=__GENERATE__
ENCRYPTION_KEY=__GENERATE__

# 任意（空ならメールは送信されず、画面に「未送信」と表示される）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 任意（使う機能を試すときだけ設定）
LINE_WORKS_BOT_ID=
LINE_WORKS_BOT_SECRET=
INBOUND_SECRET=
INBOUND_COMPANY_CODE=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
