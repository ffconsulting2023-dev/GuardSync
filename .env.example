# ─────────────────────────────────────────────
# GuardSync 環境変数
# ローカル起動時は `cp .env.example .env` して利用してください。
# 下記のデフォルト値は docker-compose.yml の PostgreSQL に対応しています。
# ─────────────────────────────────────────────

# ── 必須 ──────────────────────────────────────
# DB接続（docker compose up -d で起動する Postgres に対応）
DATABASE_URL=postgresql://guardsync:guardsync@localhost:5432/guardsync?schema=public

# JWT署名鍵（32文字以上必須／本番は openssl rand -hex 32 で生成した値に変更）
JWT_SECRET=local_dev_secret_change_me_0123456789abcdef

# APIサーバのポート。dev では Vite が /api を localhost:3001 にプロキシするため 3001 固定
PORT=3001

# development / production
NODE_ENV=development

# フロントのAPIベースURL。dev では空にして Vite プロキシ経由（/api）で接続する
VITE_API_URL=

# ── 任意（未設定でもローカル起動可能）─────────────
# アプリの公開URL（本番のCORS/メールリンク用）
APP_URL=http://localhost:5173

# 暗号化鍵（LINE Works等の機密情報保存用。32バイトhex。未設定時は平文保存＝開発向け）
ENCRYPTION_KEY=

# LINE Works連携
LINE_WORKS_BOT_ID=
LINE_WORKS_BOT_SECRET=

# メール送信（SMTP）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Webhook（受信）
INBOUND_SECRET=
INBOUND_COMPANY_CODE=

# Google Maps
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Stripe（課金。未設定時は課金機能が無効化される）
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_ENTERPRISE=
