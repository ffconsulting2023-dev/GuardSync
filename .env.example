DATABASE_URL=postgresql://user:password@host:port/database
JWT_SECRET=<64文字以上のランダム文字列>
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
VITE_API_URL=https://your-domain.com
LINE_WORKS_BOT_ID=
LINE_WORKS_BOT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INBOUND_SECRET=<Webhook認証用シークレット>  # 本番では必須（未設定だと受信Webhookを拒否）
INBOUND_COMPANY_CODE=<デフォルト受信会社コード>
ENCRYPTION_KEY=<64桁のhex文字列（openssl rand -hex 32で生成）>  # 本番では必須
GOOGLE_MAPS_API_KEY=         # Google Maps API キー（Geocoding/Maps JavaScript API）
VITE_GOOGLE_MAPS_API_KEY=    # Google Maps JavaScript API キー（フロントエンド用）

TRUST_PROXY_HOPS=1           # リバースプロキシの段数（Railway等は1）
SEED_ADMIN_PASSWORD=         # シード用スーパー管理者パスワード（未指定なら生成して表示）
SEED_DEMO_PASSWORD=          # シード用デモ管理者パスワード
