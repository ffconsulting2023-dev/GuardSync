DATABASE_URL=postgresql://user:password@host:port/database
JWT_SECRET=<64文字以上のランダム文字列>
PORT=3000
NODE_ENV=production
TZ=Asia/Tokyo
APP_URL=https://your-domain.com
VITE_API_URL=https://your-domain.com

# ── ファイルアップロード ──
# 本番（Docker）ではコンテナ外ボリュームを指す。未設定時は dist/uploads/documents。
UPLOAD_DIR=/app/uploads/documents

# ── LINE WORKS ──
LINE_WORKS_BOT_ID=
LINE_WORKS_BOT_SECRET=

# ── メール（SMTP / 任意でSendGridリレー） ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENDGRID_API_KEY=            # 任意: SendGrid経由でメール送信する場合

# ── Webhook受信 ──
INBOUND_SECRET=<Webhook認証用シークレット>
INBOUND_COMPANY_CODE=<デフォルト受信会社コード>

# ── マイナンバー暗号化（★絶対に変更しない。変更＝復号不能） ──
ENCRYPTION_KEY=<32バイトのhex文字列（openssl rand -hex 32で生成）>

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=         # Google Maps API キー（Geocoding/Maps JavaScript API、サーバー用）
VITE_GOOGLE_MAPS_API_KEY=    # Google Maps JavaScript API キー（フロントエンド用・ビルド時に埋め込み）

# ── Stripe（SaaS課金） ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=        # 各プランのStripe Price ID
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_ENTERPRISE=
